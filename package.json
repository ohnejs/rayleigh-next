{
  "name": "rayleigh-next",
  "version": "0.1.0",
  "private": true,
  "description": "A minimalistic portfolio with a gallery, an About page, a blog and a contact form, built with ohne and Next. An ohne example.",
  "homepage": "https://ohne.dev/examples/rayleigh",
  "license": "MIT",
  "author": "Muris Ceman <muris@ohne.dev>",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter web build",
    "dev": "pnpm --recursive --parallel dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "pnpm --recursive test && node --test \"tests/**/*.test.ts\"",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0"
  },
  "packageManager": "pnpm@11.5.1"
}
